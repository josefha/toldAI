PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
WORKER_ENABLED=true
DAILY_JOB_LIMIT=12
QUESTION_JOB_LIMIT=40
TRANSCRIPTION_LIMIT=60
# Optional comma-separated publisher domains. Empty permits public web discovery.
NEWS_DOMAINS=

# Optional separate model for script writing; research keeps OPENAI_MODEL.
OPENAI_SCRIPT_MODEL=gpt-6-luna

# Fast interactive routing and direct answers (research keeps OPENAI_MODEL).
OPENAI_ANSWER_MODEL=gpt-6-luna
