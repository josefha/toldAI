{
  "name": "told-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "preflight": "tsx src/preflight.ts",
    "smoke": "tsx src/smoke.ts",
    "prewarm": "tsx src/prewarm.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@supabase/supabase-js": "2.109.0",
    "fastify": "5.12.7",
    "music-metadata": "11.16.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
